[Desktop Entry]
Name=Nautilus Markdown Viewer
Comment=Rich previewer for Markdown documents in Nautilus
Exec=markdown-preview %U
Icon=io.github.markdown_previewer
Terminal=false
Type=Application
Categories=Utility;TextEditor;GNOME;GTK;
MimeType=text/markdown;text/x-markdown;
StartupNotify=true
Actions=NewWindow;

[Desktop Action NewWindow]
Name=Open New Preview Window
Exec=markdown-preview %U
